{
  "name": "oregano",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @oregano/api db:migrate",
    "db:seed": "pnpm --filter @oregano/api db:seed",
    "db:seed:demo": "pnpm --filter @oregano/api db:seed:demo",
    "test:e2e": "turbo run test:e2e",
    "build:web": "pnpm --filter @oregano/customer build:web",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:web && pnpm test:e2e",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched"
  }
}
