{
  "name": "@oregano/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db/migrate": "./src/db/migrate.ts",
    "./db/client": "./src/db/client.ts",
    "./dev/seed-demo": "./src/dev/seed-demo.ts",
    "./testing/guard": "./src/testing/guard.ts",
    "./testing/reset": "./src/testing/reset.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/dev/seed-cli.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env src/dev/seed-demo-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/websocket": "^11.3.7",
    "@oregano/contracts": "workspace:*",
    "@oregano/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oregano/api-client": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
